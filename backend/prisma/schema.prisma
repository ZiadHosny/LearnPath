generator client {
  provider = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Required, trimmed, 2–100 chars
  fullName     String     @map("full_name") @db.VarChar(100)
  /// Stored trimmed + lower-case (case-insensitive uniqueness)
  email        String     @unique @db.VarChar(254)
  /// bcrypt hash, cost 12. Never selected into API responses
  passwordHash String     @map("password_hash") @db.VarChar(60)
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  photoPath    String?    @map("photo_path") @db.VarChar(255)
  bio          String?    @db.VarChar(500)
  /// Preferred language code (EP-06); null = not chosen. Validated against the language list.
  language     String?    @db.VarChar(10)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  courses             Course[]

  @@map("users")
}

/// One row per signed-in device.
model Session {
  /// Carried in the access token as `sid`
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the cookie value
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// `created_at + 7 days`; never extended
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  endedAt          DateTime? @map("ended_at") @db.Timestamptz

  @@index([userId])
  @@map("sessions")
}

/// Failed login attempts only; keyed by email so unknown emails are treated the same.
model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  /// Normalised like `users.email`
  email       String   @db.VarChar(254)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz

  @@index([email, attemptedAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the link token
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// `created_at + 1 hour`
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz

  @@index([userId])
  @@map("password_reset_tokens")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Course categories (US-27). Names are unique ignoring case and surrounding spaces (nameKey).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(60)
  /// Trimmed lower-case name, for case-insensitive uniqueness
  nameKey   String   @unique @map("name_key") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  courses Course[]

  @@map("categories")
}

/// A course (US-12). New courses are Draft; only Published courses are ever public.
model Course {
  id               String       @id @default(uuid()) @db.Uuid
  title            String       @db.VarChar(120)
  shortDescription String       @map("short_description") @db.VarChar(250)
  description      String?      @db.VarChar(5000)
  /// "What you will learn": up to 10 items of up to 120 characters
  learningOutcomes String[]     @default([]) @map("learning_outcomes")
  level            CourseLevel
  categoryId       String       @map("category_id") @db.Uuid
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  thumbnailPath    String?      @map("thumbnail_path") @db.VarChar(255)
  status           CourseStatus @default(DRAFT)
  ownerId          String       @map("owner_id") @db.Uuid
  owner            User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([ownerId, updatedAt])
  @@index([categoryId])
  @@map("courses")
}
